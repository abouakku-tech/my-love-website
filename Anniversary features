<!-- ===== ANNIVERSARY CELEBRATION FEATURES ===== -->
<!-- Add this code BEFORE closing </body> tag -->

<style>
  /* ===== ANNIVERSARY STYLES ===== */
  
  /* Confetti Styles */
  .confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: 1000;
  }

  /* Anniversary Popup */
  .anniversary-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    padding: 40px 30px;
    border-radius: 30px;
    box-shadow: 0 20px 60px rgba(201, 24, 74, 0.4);
    z-index: 10000;
    text-align: center;
    max-width: 400px;
    animation: popup-appear 0.6s ease-out;
    border: 3px solid #ff4d6d;
  }

  @keyframes popup-appear {
    0% {
      transform: translate(-50%, -50%) scale(0.3);
      opacity: 0;
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
  }

  .anniversary-popup h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: #c9184a;
    margin-bottom: 10px;
  }

  .anniversary-popup p {
    font-size: 1rem;
    color: #800f2f;
    margin: 10px 0;
    line-height: 1.6;
  }

  .anniversary-popup .close-popup {
    margin-top: 20px;
    padding: 12px 30px;
    background: linear-gradient(135deg, #ff4d6d, #c9184a);
    color: white;
    border: none;
    border-radius: 20px;
    font-weight: 600;
    cursor: pointer;
    font-size: 1rem;
  }

  /* Fireworks */
  .firework {
    position: fixed;
    pointer-events: none;
    z-index: 999;
  }

  .firework-particle {
    position: absolute;
    border-radius: 50%;
    animation: firework-burst 1s ease-out forwards;
  }

  @keyframes firework-burst {
    to {
      transform: translate(var(--tx), var(--ty));
      opacity: 0;
    }
  }

  /* Heart Rain */
  .heart-rain {
    position: fixed;
    font-size: 2rem;
    pointer-events: none;
    z-index: 50;
    animation: rain-down 4s linear forwards;
  }

  @keyframes rain-down {
    to {
      transform: translateY(100vh);
      opacity: 0;
    }
  }

  /* Rose Petals */
  .rose-petal {
    position: fixed;
    font-size: 1.5rem;
    pointer-events: none;
    z-index: 50;
    animation: petal-fall 8s linear infinite;
  }

  @keyframes petal-fall {
    to {
      transform: translateY(100vh) rotate(360deg);
      opacity: 0;
    }
  }

  /* Anniversary Card */
  .anniversary-card {
    background: linear-gradient(135deg, rgba(255, 240, 243, 0.95), rgba(255, 204, 213, 0.8));
    border-radius: 28px;
    padding: 30px;
    border: 3px solid #ff4d6d;
    box-shadow: 0 15px 40px rgba(201, 24, 74, 0.25);
    text-align: center;
    animation: card-slide-in 0.8s ease-out;
  }

  @keyframes card-slide-in {
    from {
      transform: translateY(100px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .anniversary-card h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: #c9184a;
    margin-bottom: 15px;
  }

  .anniversary-card .date {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ff4d6d;
    margin-bottom: 15px;
  }

  .anniversary-card p {
    font-size: 1rem;
    color: #800f2f;
    line-height: 1.8;
    margin: 10px 0;
  }

  /* Achievement Badge */
  .achievement-badge {
    position: fixed;
    top: 120px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #ff4d6d, #c9184a);
    color: white;
    padding: 15px 25px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 10px 30px rgba(201, 24, 74, 0.4);
    z-index: 999;
    animation: badge-bounce 0.8s ease-out;
  }

  @keyframes badge-bounce {
    0% {
      transform: translateX(-50%) translateY(-100px);
      opacity: 0;
    }
    50% {
      transform: translateX(-50%) translateY(10px);
    }
    100% {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
  }

  /* Photo Slideshow */
  .slideshow-container {
    position: relative;
    width: 100%;
    border-radius: 22px;
    overflow: hidden;
    margin-bottom: 14px;
    border: 4px solid #ffffff;
    background-color: #fff0f3;
  }

  .slide {
    display: none;
    width: 100%;
    height: 300px;
    object-fit: cover;
    animation: fade-in 0.8s ease-in;
  }

  .slide.active {
    display: block;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .slide-counter {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: white;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Anniversary Sparkles */
  .sparkle {
    position: fixed;
    pointer-events: none;
    z-index: 100;
    animation: sparkle-twinkle 1s ease-in-out forwards;
  }

  @keyframes sparkle-twinkle {
    0%, 100% {
      opacity: 0;
      transform: scale(0);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  body.anniversary-mode {
    overflow: hidden;
  }
</style>

<!-- Anniversary Popup -->
<div id="anniversary-popup" class="anniversary-popup" style="display: none;">
  <h1>🎉 Happy 1st Anniversary! 🎉</h1>
  <p style="font-size: 1.2rem; color: #c9184a; font-weight: 700;">September 21, 2026</p>
  <p>My Dearest Izu,</p>
  <p>One year of unconditional love, laughter, and beautiful memories together.</p>
  <p style="font-weight: 600;">You are my forever. I love you! ❤️</p>
  <button class="close-popup" onclick="closeAnniversaryPopup()">💖 Close</button>
</div>

<!-- Anniversary Background Overlay -->
<div id="anniversary-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.2); z-index: 9998;"></div>

<script>
  // ===== CHECK IF TODAY IS SEPTEMBER 21 =====
  function isAnniversary() {
    const today = new Date();
    const month = today.getMonth() + 1; // 0-indexed, so +1
    const day = today.getDate();
    return month === 9 && day === 21;
  }

  const IS_ANNIVERSARY = isAnniversary();

  // ===== 1. CONFETTI EXPLOSION =====
  function createConfetti() {
    const colors = ['#ff4d6d', '#ff1d3b', '#c9184a', '#800f2f', '#ffb3c1'];
    
    for (let i = 0; i < 100; i++) {
      const confetti = document.createElement('div');
      confetti.className = 'confetti';
      confetti.style.left = Math.random() * 100 + '%';
      confetti.style.top = '-10px';
      confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
      confetti.style.animation = `float-up ${3 + Math.random() * 2}s ease-in forwards`;
      document.body.appendChild(confetti);

      setTimeout(() => confetti.remove(), 5000);
    }
  }

  // ===== 2. ANNIVERSARY POPUP =====
  function showAnniversaryPopup() {
    const popup = document.getElementById('anniversary-popup');
    const overlay = document.getElementById('anniversary-overlay');
    popup.style.display = 'block';
    overlay.style.display = 'block';
  }

  function closeAnniversaryPopup() {
    const popup = document.getElementById('anniversary-popup');
    const overlay = document.getElementById('anniversary-overlay');
    popup.style.display = 'none';
    overlay.style.display = 'none';
  }

  // ===== 3. FIREWORKS EFFECT =====
  function createFireworks() {
    const colors = ['#ff4d6d', '#ff69b4', '#ffb3c1', '#c9184a', '#ff1d3b'];
    
    for (let i = 0; i < 8; i++) {
      const x = Math.random() * window.innerWidth;
      const y = Math.random() * (window.innerHeight * 0.5);

      for (let j = 0; j < 30; j++) {
        const particle = document.createElement('div');
        particle.className = 'firework-particle';
        particle.style.left = x + 'px';
        particle.style.top = y + 'px';
        particle.style.width = '5px';
        particle.style.height = '5px';
        particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];

        const angle = (j / 30) * Math.PI * 2;
        const velocity = 5 + Math.random() * 5;
        const tx = Math.cos(angle) * velocity * 30;
        const ty = Math.sin(angle) * velocity * 30;

        particle.style.setProperty('--tx', tx + 'px');
        particle.style.setProperty('--ty', ty + 'px');

        document.body.appendChild(particle);
        setTimeout(() => particle.remove(), 1000);
      }
    }
  }

  // ===== 4. HEART RAIN =====
  function createHeartRain() {
    setInterval(() => {
      const heart = document.createElement('div');
      heart.className = 'heart-rain';
      heart.textContent = '❤️';
      heart.style.left = Math.random() * 100 + '%';
      heart.style.top = '-50px';
      document.body.appendChild(heart);

      setTimeout(() => heart.remove(), 4000);
    }, 200);
  }

  // ===== 5. ROSE PETALS =====
  function createRosePetals() {
    setInterval(() => {
      const petal = document.createElement('div');
      petal.className = 'rose-petal';
      petal.textContent = '🌹';
      petal.style.left = Math.random() * 100 + '%';
      petal.style.top = '-50px';
      petal.style.opacity = '0.7';
      document.body.appendChild(petal);

      setTimeout(() => petal.remove(), 8000);
    }, 300);
  }

  // ===== 6. SPARKLES EFFECT =====
  function createSparkles() {
    setInterval(() => {
      const sparkle = document.createElement('div');
      sparkle.className = 'sparkle';
      sparkle.textContent = '✨';
      sparkle.style.left = Math.random() * 100 + 'vw';
      sparkle.style.top = Math.random() * 100 + 'vh';
      sparkle.style.fontSize = (0.8 + Math.random() * 0.8) + 'rem';
      document.body.appendChild(sparkle);

      setTimeout(() => sparkle.remove(), 1000);
    }, 300);
  }

  // ===== 7. SPECIAL ANNIVERSARY SONG =====
  function playAnniversarySong() {
    // Create audio element for anniversary song
    const anniversarySong = document.createElement('audio');
    anniversarySong.id = 'anniversary-song';
    anniversarySong.loop = true;
    anniversarySong.volume = 0.3;
    
    // You can add a song URL here
    // anniversarySong.src = './anniversary-song.mp3'; // Optional
    
    document.body.appendChild(anniversarySong);
    anniversarySong.play().catch(() => {
      console.log('Song autoplay blocked - user interaction required');
    });
  }

  // ===== 8. ANNIVERSARY CARD SECTION =====
  function insertAnniversaryCard() {
    const container = document.querySelector('.container');
    
    const card = document.createElement('div');
    card.className = 'card anniversary-card';
    card.style.marginTop = '24px';
    card.style.borderColor = '#ff4d6d';
    card.innerHTML = `
      <h2>🎉 1st Anniversary Celebration 🎉</h2>
      <div class="date">September 21, 2026</div>
      
      <div class="slideshow-container">
        <img src="./couple1.jpeg" alt="Memory 1" class="slide active">
        <img src="./couple2.jpeg" alt="Memory 2" class="slide">
        <img src="./meet up pic.jpeg" alt="Memory 3" class="slide">
        <div class="slide-counter">
          <span id="slide-current">1</span> / 3
        </div>
      </div>

      <p style="margin-top: 20px;">
        <strong>One Amazing Year Together!</strong>
      </p>
      <p>
        From our first surprise meet on July 15, 2026, to this beautiful moment - every day with you has been a blessing.
      </p>
      <p style="font-style: italic; color: #c9184a;">
        "You are my favorite person, my happiness, my peace, and my forever." 💖
      </p>
      <p style="margin-top: 15px; font-weight: 600;">
        Here's to more memories, more love, and more moments together!
      </p>
      <p style="font-size: 1.3rem; margin-top: 15px;">
        I Love You Forever, Izu ❤️
      </p>
    `;

    container.insertBefore(card, container.firstChild);

    // Photo Slideshow Auto-Play
    let currentSlide = 0;
    const slides = card.querySelectorAll('.slide');
    const slideCounter = card.querySelector('#slide-current');

    setInterval(() => {
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
      slideCounter.textContent = currentSlide + 1;
    }, 5000); // Change photo every 5 seconds
  }

  // ===== 9. ACHIEVEMENT BADGE =====
  function showAchievementBadge() {
    const badge = document.createElement('div');
    badge.className = 'achievement-badge';
    badge.innerHTML = '🏆 1st Anniversary Unlocked! 🎉';
    document.body.appendChild(badge);

    setTimeout(() => {
      badge.style.animation = 'badge-bounce 0.8s ease-in reverse forwards';
      setTimeout(() => badge.remove(), 800);
    }, 8000);
  }

  // ===== 10. ANNIVERSARY MODE ACTIVATION =====
  function activateAnniversaryMode() {
    if (!IS_ANNIVERSARY) return;

    // Add multiple effects with timing
    createConfetti();
    setTimeout(showAnniversaryPopup, 500);
    setTimeout(createFireworks, 1500);
    createHeartRain();
    createRosePetals();
    createSparkles();
    setTimeout(insertAnniversaryCard, 1000);
    showAchievementBadge();
    
    // Try to play special song (if available)
    playAnniversarySong();
  }

  // ===== ACTIVATE ON PAGE LOAD =====
  window.addEventListener('load', () => {
    activateAnniversaryMode();
  });

  // Allow manual activation for testing (remove in production)
  window.triggerAnniversary = activateAnniversaryMode;
</script>
